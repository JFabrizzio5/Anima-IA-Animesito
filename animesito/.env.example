# Copy to .env and fill in. Never commit .env.

JFAST_APP_NAME=animesito
JFAST_ENV=local            # local | dev | staging | prod
JFAST_DEBUG=false          # true leaks exception messages to clients
JFAST_PORT=7789

JFAST_LOG_LEVEL=INFO

# database plugin -- also read by migrations/env.py.
JFAST_DB_DSN=postgresql+asyncpg://app:CHANGEME@localhost:7790/app
POSTGRES_PASSWORD=CHANGEME

# cache plugin (also the job queue and the progress bus)
JFAST_CACHE_URL=redis://localhost:7792/0

# comfy plugin: where ComfyUI listens, and its models folder as THIS process
# sees it (for reading safetensors headers: v-prediction, LoRA base).
JFAST_COMFY_URL=http://127.0.0.1:8188
JFAST_COMFY_MODELS_DIR=/mnt/c/Users/GIGABYTE/Desktop/ComfyUI/models

# jobs plugin: set false on a process that must never feed ComfyUI.
# JFAST_JOBS_DISPATCHER=true
